{
  "expo": {
    "name": "Salterra-testing",
    "slug": "Salterra-testing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/salterra-app-icon.png",
    "scheme": "salterratesting",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/salterra-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/salterra-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/salterra-wordmark.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SALTERRA to show and update your location while the Map is open. / Να επιτρέπεται στο SALTERRA να εμφανίζει και να ενημερώνει την τοποθεσία σου όσο ο Χάρτης είναι ανοιχτός."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
